{
  "name": "termxxle",
  "version": "0.3.1",
  "description": "SSH, SFTP und Linux-Servermonitoring für Windows und Web",
  "author": "xjustanoah",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node start-server.cjs\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "test": "node --test",
    "start": "node start-server.cjs",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "nodemailer": "^10.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch@^10.2.5": "11.0.1",
    "minimatch@^9.0.3": "11.0.1"
  },
  "build": {
    "appId": "com.nexterm.desk",
    "productName": "Termxxle",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "project-env.cjs",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "icon": "electron/termxxle-app-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Termxxle-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
