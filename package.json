{
  "name": "nexterm-desk",
  "version": "0.2.7",
  "description": "SSH, SFTP und Servermonitoring als Desktop-App",
  "author": "NexTerm Desk",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"node start-server.cjs\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node start-server.cjs",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.1.0",
    "nodemailer": "^10.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.1.0"
  },
  "overrides": {
    "minimatch@^10.2.5": "11.0.1",
    "minimatch@^9.0.3": "11.0.1"
  },
  "build": {
    "appId": "com.nexterm.desk",
    "productName": "NexTerm Desk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "icon": "electron/nexterm-app-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "NexTerm-Desk-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
